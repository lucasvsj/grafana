# ==============================================
# GRAFANA - CREDENCIALES DE ADMINISTRADOR
# ==============================================
# Usuario administrador principal (único usuario inicial)
GRAFANA_ADMIN_USER=admin

# Contraseña del administrador (mínimo 12 caracteres, usar caracteres especiales)
# IMPORTANTE: Cambiar esta contraseña antes de usar en producción
GRAFANA_ADMIN_PASSWORD=changeme_secure_password_123

# Secret key para encriptación de datos sensibles
# Generar con: openssl rand -base64 32
GRAFANA_SECRET_KEY=changeme_generate_random_key_here

# ==============================================
# SMTP - CONFIGURACIÓN DE EMAIL (OPCIONAL)
# ==============================================
# Habilitar envío de emails (notificaciones, alertas, etc)
SMTP_ENABLED=false

# Servidor SMTP
SMTP_HOST=smtp.gmail.com:587

# Usuario SMTP
SMTP_USER=your-email@gmail.com

# Contraseña SMTP o App Password
SMTP_PASSWORD=your-smtp-password

# Email de origen (from)
SMTP_FROM_ADDRESS=grafana@lucasvsj.com

# ==============================================
# API DJANGO - INTEGRACIÓN FUTURA
# ==============================================
# URL de la API Django para gestión de usuarios (cuando esté disponible)
# DJANGO_API_URL=https://api.lucasvsj.com
# DJANGO_API_KEY=your-api-key-here

# ==============================================
# NOTAS DE SEGURIDAD
# ==============================================
# 1. NUNCA commitear este archivo .env con credenciales reales
# 2. Copiar este archivo a .env y modificar los valores
# 3. El archivo .env debe estar en .gitignore
# 4. Para producción, usar contraseñas fuertes (mínimo 16 caracteres)
# 5. Rotar el GRAFANA_SECRET_KEY periódicamente
# 6. Si usas SMTP con Gmail, crear App Password desde Google Account Security
