# Directorio para reglas de alertas de Prometheus
# Formato YAML con reglas de alerting

# Ejemplo de archivo de alerta (crear como alert-rules.yml):
# groups:
#   - name: example
#     rules:
#     - alert: InstanceDown
#       expr: up == 0
#       for: 5m
#       labels:
#         severity: critical
#       annotations:
#         summary: "Instance {{ $labels.instance }} down"
#         description: "{{ $labels.instance }} has been down for more than 5 minutes."
